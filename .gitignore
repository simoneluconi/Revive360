# Photos and videos pulled from the camera
*.SRW
*.MP4

# Android release artefacts and signing keys
*.apk
*.aab
*.jks
*.keystore

# Samsung's firmware images: kept locally in firmware/, never published
/firmware/*
!/firmware/README.md

