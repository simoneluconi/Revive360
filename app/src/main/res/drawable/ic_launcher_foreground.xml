<?xml version="1.0" encoding="utf-8"?>
<!-- The camera of the app's own line icons (AppIcons.Camera360), drawn big: a 24-unit grid scaled 2.4x
     into the 66 dp safe zone of the adaptive icon, with the same round 2-unit strokes as the UI -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="2.4"
        android:scaleY="2.4"
        android:translateX="25.2"
        android:translateY="25.2">
        <!-- the ball -->
        <path
            android:pathData="M5,10a7,7 0 1 0 14,0a7,7 0 1 0 -14,0"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="2" />
        <!-- the lens -->
        <path
            android:pathData="M9.5,10a2.5,2.5 0 1 0 5,0a2.5,2.5 0 1 0 -5,0"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="2" />
        <!-- the stand -->
        <path
            android:pathData="M9,17l-1,4h8l-1,-4"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
