# Revive360 - controller configuration (on the SD card: /g360r/g360r.conf)
#
# Format: KEY=VALUE, one per line, no inline comments. Lines starting with '#'
# are ignored. ./install.sh sd creates g360r.conf from this file.

# softAP passphrase (WPA2-PSK): 8-63 printable ASCII characters, no commas.
# CHANGE_ME = the camera makes a random one at its first start; the phone gets it
# over Bluetooth while pairing (the first 3 minutes after the camera is switched on).
psk=CHANGE_ME

# ble = the Wi-Fi stays off until a phone asks over Bluetooth, and goes off again
# after wifi_idle seconds without a request over it; on = always on (as before).
# With ble the Wi-Fi comes on anyway when the Bluetooth side does not start.
wifi=ble
wifi_idle=600

# SSID override. Empty = G360R-<last 3 bytes of the wlan0 MAC> (protocol.md §1).
ssid=

# Wi-Fi band: 5 = 5 GHz (802.11ac, 80 MHz: the bandwidth the live view needs), falling
# back to 2.4 GHz on its own when the radio cannot; 2.4 = 2.4 GHz only (for a
# phone without 5 GHz).
band=5

# 5 GHz channel (36-48: no radar detection needed, allowed indoors in Europe).
channel_5g=36

# 2.4 GHz channel.
channel=6

# HTTP port (protocol.md §2).
port=8360

# LED roles by sysfs index led.0..led.4, comma separated. Allowed:
# status_red status_green status_blue front rear charge unknown.
# Fill in after running the LED diagnostic (ledtest=1).
led_roles=unknown,unknown,unknown,unknown,unknown

# Which LEDs show the controller's own feedback: all | none | list of indices.
# none until the led.N mapping is known: driving all five sysfs LEDs reset the
# camera in Test 1 (one of them is likely not an LED).
led_feedback=none

# Which LEDs blink on error (list of indices). Empty = the status_red LED if
# mapped, else the feedback LEDs. none = no LED.
led_error=none

# 1 = run the LED mapping diagnostic at boot (about 75 s) before starting.
ledtest=0

# 1 = after the server starts, run the on-camera API self-test: info, status,
# files, capture photo / raw+photo / raw, thumbnails. Responses are saved in
# g360r/log/selftest/. Works without Wi-Fi. Takes the shots for real.
selftest=0

# Advanced (leave as is unless told otherwise):
# adapter=c200            force an adapter (c200 | r210 | generic)
# storage_root=/opt/storage/sdcard
# storage_mount=/opt/storage/sdcard
# battery_supply=battery  force the power_supply entry used for status
# capture_enable=1
