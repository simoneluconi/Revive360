[Unit]
Description=Revive360 firmware boot signature on the LEDs (before the stock app takes them)
DefaultDependencies=no
# After deviced (it may reset the LEDs when it starts), before the stock app
After=local-fs.target deviced.service
Before=di-camera-app.service

[Service]
Type=oneshot
ExecStart=/usr/share/g360r/boot_leds.sh
TimeoutStartSec=10

[Install]
WantedBy=default.target
